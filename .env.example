# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (automatically configured from Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# AI APIs (Free Tier - Required)
GEMINI_API_KEY=your-gemini-api-key-here
NVIDIA_API_KEY=your-nvidia-nim-api-key-here

# AI APIs (Premium - Optional)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Service URLs (for local development)
NEXT_PUBLIC_COMPLIANCE_API_URL=http://localhost:8000
NEXT_PUBLIC_IMAGE_API_URL=http://localhost:8001
NEXT_PUBLIC_CREATIVE_API_URL=http://localhost:8002

# Optional: Monitoring & Analytics
SENTRY_DSN=
POSTHOG_KEY=
