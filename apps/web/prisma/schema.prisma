// Prisma schema for TescoCreate AI
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (will integrate with Supabase Auth later)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatives     Creative[]
  brandAssets   BrandAsset[]
  colorPalettes ColorPalette[]

  @@map("users")
}

// Creative (the main entity)
model Creative {
  id          String   @id @default(cuid())
  userId      String
  title       String
  format      Format
  canvasState Json // Fabric.js JSON state
  thumbnail   String? // URL to thumbnail image
  status      CreativeStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  compliance ComplianceResult?
  exports    Export[]

  @@index([userId])
  @@index([status])
  @@map("creatives")
}

// Compliance validation results
model ComplianceResult {
  id         String   @id @default(cuid())
  creativeId String   @unique
  score      Int // 0-100
  violations Json // Array of violations
  warnings   Json // Array of warnings
  passedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@map("compliance_results")
}

// Exported creatives
model Export {
  id         String       @id @default(cuid())
  creativeId String
  format     Format
  fileUrl    String // Supabase Storage URL
  fileSize   Int // bytes
  width      Int
  height     Int
  status     ExportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
  @@map("exports")
}

// Brand assets (packshots, logos, backgrounds)
model BrandAsset {
  id        String    @id @default(cuid())
  userId    String
  type      AssetType
  name      String
  fileUrl   String // Supabase Storage URL
  fileSize  Int
  width     Int?
  height    Int?
  metadata  Json? // Colors extracted, AI analysis, etc.
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("brand_assets")
}

// Color palettes
model ColorPalette {
  id        String   @id @default(cuid())
  userId    String
  name      String
  colors    Json // Array of hex colors
  metadata  Json? // WCAG compliance info, etc.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("color_palettes")
}

// Enums
enum Format {
  SQUARE_1_1 // 1:1 (1080x1080)
  PORTRAIT_4_5 // 4:5 (1080x1350)
  STORIES_9_16 // 9:16 (1080x1920)
}

enum CreativeStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssetType {
  PACKSHOT
  LOGO
  BACKGROUND
  VALUE_TILE
  OTHER
}
